# =============================================================================
# JobTap — Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment.
#
# PRODUCTION REQUIREMENTS:
#   A subset of variables MUST be changed from their defaults before deploying
#   to production.  The application validates these at startup when
#   NODE_ENV=production and will refuse to start if defaults are detected.
# =============================================================================

# Server port
PORT=3000

# ---------------------------------------------------------------------------
# DATABASE  (REQUIRED in production)
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://jobtap:jobtap@localhost:5432/jobtap
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=jobtap
POSTGRES_PASSWORD=jobtap
POSTGRES_DB=jobtap

# !!! PRODUCTION: MUST be "false". Never run with synchronize=true in
#     production — it can silently drop data. Use migrations instead.
TYPEORM_SYNCHRONIZE=false

# ---------------------------------------------------------------------------
# AUTHENTICATION
# ---------------------------------------------------------------------------
# !!! PRODUCTION: Generate a strong random secret (e.g. openssl rand -hex 64)
#     and NEVER use the default value below.
JWT_SECRET=replace-with-a-long-random-secret

# !!! PRODUCTION: Set to a real email address for the initial admin account.
ADMIN_EMAIL=admin@jobtap.local

# !!! PRODUCTION: Set a strong, unique password (min 12 chars, mixed case +
#     digits/symbols). Do NOT use the default value below.
ADMIN_PASSWORD=replace-this-password

# ---------------------------------------------------------------------------
# ANALYTICS
# ---------------------------------------------------------------------------
# Max analytics events a single device can submit per minute (rate limit).
# Adjust based on expected traffic in production.
ANALYTICS_RATE_LIMIT_PER_MINUTE=60
